<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Mucke, Baby!</string>
    <!-- Entwicklungssprache Deutsch; zusaetzlich Englisch lokalisiert (de/en.lproj). -->
    <key>CFBundleDevelopmentRegion</key>
    <string>de</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>de</string>
        <string>en</string>
    </array>
    <key>CFBundleDisplayName</key>
    <string>Mucke, Baby!</string>
    <key>CFBundleIdentifier</key>
    <string>de.danielmuller.macradio</string>
    <key>CFBundleExecutable</key>
    <string>MuckeBaby</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- Beide Versionsfelder werden beim Build aus Models.swift (AppInfo.version)
         gespiegelt. CFBundleVersion muss monoton steigen: Sparkle vergleicht
         Updates ausschliesslich darueber. -->
    <key>CFBundleShortVersionString</key>
    <string>1.8.0</string>
    <key>CFBundleVersion</key>
    <string>1.8.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.2</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <!-- CoreAudio Process-Tap (Audio-Reaktivität der Visualizer) tappt die eigene Tonausgabe.
         Ohne diesen Schlüssel liefert der Tap stumme Nullen (TCC verweigert still). -->
    <key>NSAudioCaptureUsageDescription</key>
    <string>„Mucke, Baby!“ analysiert die eigene Tonausgabe, damit die Visualizer synchron zur Musik reagieren.</string>
    <!-- Viele Radiostreams laufen ueber http (nicht https) -> ATS oeffnen. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <!-- Sparkle-Selbst-Update: prueft automatisch, installiert aber erst nach
         Zustimmung. Feed liegt auf GitHub Pages, das DMG beim GitHub Release.
         Archiv und Feed werden gegen den projektspezifischen Ed25519-Schluessel
         geprueft (privater Gegenpart NIE im Repo; siehe docs/sparkle-release.md). -->
    <key>SUFeedURL</key>
    <string>https://danielmuellerir.github.io/mucke_baby/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>l4OwMMvBBl+/YaqW9kuJ9ywAjQR9a/bUCXFDztc/z7U=</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUAutomaticallyUpdate</key>
    <false/>
    <key>SUAllowsAutomaticUpdates</key>
    <false/>
    <!-- Keine anonymen Hardware-/Systemprofildaten an den Feed anhaengen. -->
    <key>SUEnableSystemProfiling</key>
    <false/>
    <key>SUVerifyUpdateBeforeExtraction</key>
    <true/>
    <key>SURequireSignedFeed</key>
    <true/>
</dict>
</plist>
